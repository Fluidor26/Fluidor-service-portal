# --- Supabase (Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# Alleen op de server! Nodig voor het uitnodigen van gebruikers en de import.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Publieke adres van het portaal (zonder / aan het eind)
APP_URL=https://service.fluidor.com

# --- E-mailmeldingen (optioneel; leeg = geen meldingen) ---
# Voor Microsoft 365: smtp.office365.com, poort 587, een servicemailbox met SMTP AUTH.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=service@fluidor.com
SMTP_PASS=
MAIL_FROM="Fluidor Service <service@fluidor.com>"
# Hier komen meldingen van nieuwe tickets binnen
SERVICEDESK_EMAIL=service@fluidor.com
